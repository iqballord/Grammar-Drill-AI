# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/grammar_learning?schema=public"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# AI Integration - Using Gemini
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model Selection (Free Tier Quotas)
# gemini-1.5-flash: 1500 requests/day (RECOMMENDED for production)
# gemini-2.5-flash-lite: Higher quota, faster response
# gemini-1.5-pro: 1500 requests/day, better quality but slower
# gemini-2.5-flash: 20 requests/day (avoid for production)
GEMINI_MODEL="gemini-1.5-flash"

# Server Configuration
PORT=3000
API_PORT=3001
NODE_ENV="development"
USE_WEBHOOK=false

# Security Configuration
# Comma-separated list of allowed Telegram user IDs (for bot access control)
# Example: ALLOWED_TELEGRAM_IDS="123456789,987654321"
ALLOWED_TELEGRAM_IDS=""

# Bearer token for API authentication (dashboard access)
# Generate with: openssl rand -hex 32
API_BEARER_TOKEN="your_secure_random_token_here"
